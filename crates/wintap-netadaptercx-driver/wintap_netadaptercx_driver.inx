[Version]
Signature = "$WINDOWS NT$"
Class = Net
ClassGuid = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider = %ProviderName%
DriverVer = 08/12/2026,1.0.0.1
CatalogFile = wintap_netadaptercx_driver.cat
PnpLockdown = 1

[Manufacturer]
%ProviderName% = Standard,NTamd64.10.0...19041,NTarm64.10.0...19041

[Standard.NTamd64.10.0...19041]
%WinTapDeviceDesc% = WinTapChild_Install, WINTAPBUS\WinTapChild

[Standard.NTarm64.10.0...19041]
%WinTapDeviceDesc% = WinTapChild_Install, WINTAPBUS\WinTapChild

[WinTapChild_Install]
Characteristics = 0x1
*IfType = 0x6
*MediaType = 0x0
*PhysicalMediaType = 0
*AccessType = 2
*ConnectionType = 1
*DirectionType = 0
*IfConnectorPresent = 0
CopyFiles = WinTapChild_CopyFiles
AddReg = WinTapChild_AddReg

[WinTapChild_Install.Services]
AddService = WinTapChild, 2, WinTapChild_Service

[WinTapChild_CopyFiles]
wintap_netadaptercx_driver.sys

[DestinationDirs]
WinTapChild_CopyFiles = 13

[SourceDisksNames]
1 = %DiskName%,,

[SourceDisksFiles]
wintap_netadaptercx_driver.sys = 1

[WinTapChild_Service]
DisplayName = %WinTapChildServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\wintap_netadaptercx_driver.sys
LoadOrderGroup = NDIS

[WinTapChild_AddReg]
HKR,,Security,,"D:P(A;;GA;;;BA)"
HKR, Ndi, Service, 0, "WinTapChild"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[Strings]
ProviderName = "WinTapRust contributors"
DiskName = "WinTap child installation media"
WinTapDeviceDesc = "WinTap dynamic Virtual Ethernet Adapter"
WinTapChildServiceDesc = "WinTap TAP Child Driver"
